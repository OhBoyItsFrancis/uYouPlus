@@ -0,0 +1,58 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# [ios-blink-sideload] Ad and content blocking for the single-process Blink
+# build, using Chromium's subresource filter with filter lists compiled from
+# uBlock Origin's default lists (see adblock.gni).
+
+import("//ios/web/content/adblock/adblock.gni")
+
+source_set("adblock") {
+  sources = [
+    "adblock_navigation_throttle.h",
+    "adblock_navigation_throttle.mm",
+    "adblock_render_frame_observer.h",
+    "adblock_render_frame_observer.mm",
+    "adblock_ruleset.h",
+    "adblock_ruleset.mm",
+  ]
+
+  deps = [
+    "//base",
+    "//components/subresource_filter/content/renderer",
+    "//components/subresource_filter/core/common",
+    "//components/subresource_filter/core/mojom",
+    "//components/subresource_filter/tools/rule_parser",
+    "//components/url_pattern_index",
+    "//components/url_pattern_index/proto:url_pattern_index",
+    "//components/version_info",
+    "//content/public/browser",
+    "//content/public/renderer",
+    "//ios/web/common:features",
+    "//third_party/blink/public:blink",
+    "//third_party/blink/public:blink_headers",
+    "//third_party/blink/public/common",
+    "//url",
+  ]
+
+  if (ios_sideload_adblock_lists_dir != "") {
+    deps += [ ":filter_lists" ]
+  }
+
+  frameworks = [ "Foundation.framework" ]
+}
+
+if (ios_sideload_adblock_lists_dir != "") {
+  # The three files written by compile_filters.py. They end up in the bundle
+  # that links this code; adblock_ruleset.mm looks in that bundle and in the
+  # main app bundle.
+  bundle_data("filter_lists") {
+    sources = [
+      "$ios_sideload_adblock_lists_dir/adblock_filters.txt",
+      "$ios_sideload_adblock_lists_dir/adblock_generic.css",
+      "$ios_sideload_adblock_lists_dir/adblock_generic_exceptions.txt",
+    ]
+    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+  }
+}
