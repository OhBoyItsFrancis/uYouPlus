+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_NAVIGATION_THROTTLE_H_
+#define IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_NAVIGATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace web::adblock {
+
+// [ios-blink-sideload] Blocks iframe navigations that match the ad blocking
+// ruleset and collapses the iframe, like Chrome's
+// ChildFrameNavigationFilteringThrottle. Subresources are filtered in the
+// renderer (AdblockRenderFrameObserver); iframe documents are navigations, so
+// they are checked here. Top-level navigations are never blocked.
+class AdblockNavigationThrottle : public content::NavigationThrottle {
+ public:
+  // Adds the throttle for subframe navigations when ad blocking is on.
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit AdblockNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  AdblockNavigationThrottle(const AdblockNavigationThrottle&) = delete;
+  AdblockNavigationThrottle& operator=(const AdblockNavigationThrottle&) =
+      delete;
+  ~AdblockNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult CheckCurrentUrl();
+};
+
+}  // namespace web::adblock
+
+#endif  // IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_NAVIGATION_THROTTLE_H_
diff --git a/ios/web/content/adblock/adblock_navigation_throttle.mm b/ios/web/content/adblock/adblock_navigation_throttle.mm
new file mode 100644
index 0000000000000000000000000000000000000000..25061bbdb187ff79db5956f89034d65d6b4b2155
--- /dev/null
+++ b/ios/web/content/adblock/adblock_navigation_throttle.mm
@@ -0,0 +1,115 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/adblock/adblock_navigation_throttle.h"
+
+#import <memory>
+
+#import "base/feature_list.h"
+#import "components/subresource_filter/core/common/first_party_origin.h"
+#import "components/subresource_filter/core/common/indexed_ruleset.h"
+#import "components/subresource_filter/core/common/load_policy.h"
+#import "components/url_pattern_index/proto/rules.pb.h"
+#import "content/public/browser/navigation_handle.h"
+#import "content/public/browser/navigation_throttle_registry.h"
+#import "content/public/browser/render_frame_host.h"
+#import "ios/web/common/features.h"
+#import "ios/web/content/adblock/adblock_ruleset.h"
+#import "url/gurl.h"
+#import "url/origin.h"
+
+namespace web::adblock {
+
+namespace {
+
+using url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT;
+using url_pattern_index::proto::ACTIVATION_TYPE_GENERICBLOCK;
+
+}  // namespace
+
+// static
+void AdblockNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  if (!base::FeatureList::IsEnabled(web::features::kIOSSideloadAdblock) ||
+      registry.GetNavigationHandle().IsInMainFrame()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<AdblockNavigationThrottle>(registry));
+}
+
+AdblockNavigationThrottle::AdblockNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+AdblockNavigationThrottle::~AdblockNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+AdblockNavigationThrottle::WillStartRequest() {
+  return CheckCurrentUrl();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AdblockNavigationThrottle::WillRedirectRequest() {
+  return CheckCurrentUrl();
+}
+
+const char* AdblockNavigationThrottle::GetNameForLogging() {
+  return "AdblockNavigationThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AdblockNavigationThrottle::CheckCurrentUrl() {
+  const GURL& url = navigation_handle()->GetURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return PROCEED;
+  }
+  content::RenderFrameHost* parent =
+      navigation_handle()->GetParentFrameOrOuterDocument();
+  if (!parent) {
+    return PROCEED;
+  }
+  scoped_refptr<const AdblockRuleset::Data> data =
+      AdblockRuleset::GetInstance().GetData();
+  if (!data) {
+    return PROCEED;
+  }
+
+  subresource_filter::IndexedRulesetMatcher matcher(data->indexed_bytes());
+
+  // An allowlist rule with $document (or $genericblock) on the parent
+  // document or any of its ancestors turns blocking off (or generic blocking
+  // rules off) for everything below it; see ComputeActivationState().
+  bool disable_generic_rules = false;
+  for (content::RenderFrameHost* frame = parent; frame;
+       frame = frame->GetParentOrOuterDocument()) {
+    const GURL& document_url = frame->GetLastCommittedURL();
+    if (!document_url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    content::RenderFrameHost* frame_parent = frame->GetParentOrOuterDocument();
+    const url::Origin parent_origin =
+        frame_parent ? frame_parent->GetLastCommittedOrigin() : url::Origin();
+    if (matcher.ShouldDisableFilteringForDocument(document_url, parent_origin,
+                                                  ACTIVATION_TYPE_DOCUMENT)) {
+      return PROCEED;
+    }
+    if (matcher.ShouldDisableFilteringForDocument(
+            document_url, parent_origin, ACTIVATION_TYPE_GENERICBLOCK)) {
+      disable_generic_rules = true;
+    }
+  }
+
+  subresource_filter::LoadPolicy load_policy =
+      matcher.GetLoadPolicyForResourceLoad(
+          url,
+          subresource_filter::FirstPartyOrigin(
+              parent->GetLastCommittedOrigin()),
+          url_pattern_index::proto::ELEMENT_TYPE_SUBDOCUMENT,
+          disable_generic_rules, /*out_rule=*/nullptr);
+  return load_policy == subresource_filter::LoadPolicy::DISALLOW
+             ? BLOCK_REQUEST_AND_COLLAPSE
+             : PROCEED;
+}
+
+}  // namespace web::adblock
diff --git a/ios/web/content/adblock/adblock_render_frame_observer.h b/ios/web/content/adblock/adblock_render_frame_observer.h
new file mode 100644
