+++ b/ios/web/content/adblock/adblock_render_frame_observer.h
@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RENDER_FRAME_OBSERVER_H_
+#define IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RENDER_FRAME_OBSERVER_H_
+
+#include <string>
+
+#include "components/subresource_filter/core/mojom/subresource_filter.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "url/origin.h"
+
+namespace web::adblock {
+
+// [ios-blink-sideload] Applies the ad blocking ruleset to each document in a
+// frame, much like subresource_filter::SubresourceFilterAgent, but always
+// active (Chrome only activates the filter on sites Safe Browsing flags):
+//  - installs a blink::WebDocumentSubresourceFilter, so Blink blocks matching
+//    subresource loads (scripts, images, XHR/fetch, ...), also in workers;
+//  - inserts a user stylesheet hiding elements that match the element hiding
+//    rules for the document's site, plus the generic ones in main frames.
+// Allowlist rules with $document, $genericblock, $elemhide and $generichide
+// are honoured, and inherited by child frames.
+class AdblockRenderFrameObserver
+    : public content::RenderFrameObserver,
+      public content::RenderFrameObserverTracker<AdblockRenderFrameObserver> {
+ public:
+  // Deletes itself when the frame goes away.
+  explicit AdblockRenderFrameObserver(content::RenderFrame* render_frame);
+  AdblockRenderFrameObserver(const AdblockRenderFrameObserver&) = delete;
+  AdblockRenderFrameObserver& operator=(const AdblockRenderFrameObserver&) =
+      delete;
+  ~AdblockRenderFrameObserver() override;
+
+  // content::RenderFrameObserver:
+  void DidCreateNewDocument() override;
+  void DidCreateDocumentElement() override;
+  void WillCreateWorkerFetchContext(blink::WebWorkerFetchContext*) override;
+  void OnDestruct() override;
+
+ private:
+  // State of the current document, inherited by documents in child frames.
+  struct DocumentState {
+    bool filtering_disabled = false;         // $document
+    bool generic_blocking_disabled = false;  // $genericblock
+    bool hiding_disabled = false;            // $elemhide
+    bool generic_hiding_disabled = false;    // $generichide
+  };
+
+  DocumentState state_;
+  bool has_filter_ = false;
+  url::Origin document_origin_;
+  subresource_filter::mojom::ActivationState activation_state_;
+  // Element hiding stylesheet, inserted once the document element exists.
+  std::string pending_css_;
+};
+
+}  // namespace web::adblock
+
+#endif  // IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RENDER_FRAME_OBSERVER_H_
