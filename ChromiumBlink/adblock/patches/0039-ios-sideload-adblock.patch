+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RULESET_H_
+#define IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RULESET_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+
+namespace web::adblock {
+
+// [ios-blink-sideload] Process-wide holder of the ad blocking ruleset.
+//
+// On first launch the bundled filter list is parsed with Chromium's EasyList
+// parser and indexed into the subresource filter's flatbuffer format, which is
+// cached under Library/Caches/SideloadAdblock and reused until the bundled
+// list or the Chromium version changes. The browser process and the in-process
+// renderer (this build runs single-process) share the same files.
+class AdblockRuleset {
+ public:
+  // Immutable once published; safe to use from any thread.
+  class Data : public base::RefCountedThreadSafe<Data> {
+   public:
+    Data();
+    Data(const Data&) = delete;
+    Data& operator=(const Data&) = delete;
+
+    // The indexed ruleset file. Each thread that needs a
+    // subresource_filter::MemoryMappedRuleset (which is not thread-safe) maps
+    // its own copy from this path.
+    const base::FilePath& indexed_path() const { return indexed_path_; }
+
+    // The indexed ruleset, mapped once for browser-side matching.
+    base::span<const uint8_t> indexed_bytes() const LIFETIME_BOUND {
+      return mapped_->bytes();
+    }
+
+    // Generic element hiding rules, as a ready-to-insert stylesheet.
+    const std::string& generic_css() const { return generic_css_; }
+
+    // Generic hiding selectors that some sites except, with those sites.
+    struct ExceptedSelector {
+      ExceptedSelector();
+      ExceptedSelector(const ExceptedSelector&);
+      ExceptedSelector(ExceptedSelector&&);
+      ~ExceptedSelector();
+      std::vector<std::string> domains;
+      std::string selector;
+    };
+    const std::vector<ExceptedSelector>& generic_exceptions() const {
+      return generic_exceptions_;
+    }
+
+   private:
+    friend class base::RefCountedThreadSafe<Data>;
+    friend class AdblockRuleset;
+    ~Data();
+
+    base::FilePath indexed_path_;
+    std::unique_ptr<base::MemoryMappedFile> mapped_;
+    std::string generic_css_;
+    std::vector<ExceptedSelector> generic_exceptions_;
+  };
+
+  static AdblockRuleset& GetInstance();
+
+  AdblockRuleset(const AdblockRuleset&) = delete;
+  AdblockRuleset& operator=(const AdblockRuleset&) = delete;
+
+  // Loads (or builds) the ruleset on a background thread. Call once the task
+  // scheduler is running; later calls do nothing.
+  void StartLoading();
+
+  // Returns the ruleset, or null while loading, if the app bundle has no
+  // filter lists, or if the ad blocker is turned off in chrome://flags.
+  scoped_refptr<const Data> GetData() const;
+
+ private:
+  friend class base::NoDestructor<AdblockRuleset>;
+
+  AdblockRuleset();
+  ~AdblockRuleset();
+
+  static scoped_refptr<const Data> LoadOnBackgroundThread();
+  void Publish(scoped_refptr<const Data> data);
+
+  mutable base::Lock lock_;
+  bool started_ GUARDED_BY(lock_) = false;
+  scoped_refptr<const Data> data_ GUARDED_BY(lock_);
+};
+
+}  // namespace web::adblock
+
+#endif  // IOS_WEB_CONTENT_ADBLOCK_ADBLOCK_RULESET_H_
