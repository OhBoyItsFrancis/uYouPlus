+#import "components/subresource_filter/core/common/memory_mapped_ruleset.h"
+#import "components/url_pattern_index/proto/rules.pb.h"
+#import "content/public/renderer/render_frame.h"
+#import "ios/web/common/features.h"
+#import "ios/web/content/adblock/adblock_ruleset.h"
+#import "third_party/blink/public/platform/web_string.h"
+#import "third_party/blink/public/platform/web_worker_fetch_context.h"
+#import "third_party/blink/public/web/web_css_origin.h"
+#import "third_party/blink/public/web/web_document.h"
+#import "third_party/blink/public/web/web_document_loader.h"
+#import "third_party/blink/public/web/web_frame.h"
+#import "third_party/blink/public/web/web_local_frame.h"
+#import "url/gurl.h"
+#import "url/url_constants.h"
+#import "url/url_util.h"
+
+namespace web::adblock {
+
+namespace {
+
+using url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT;
+using url_pattern_index::proto::ACTIVATION_TYPE_ELEMHIDE;
+using url_pattern_index::proto::ACTIVATION_TYPE_GENERICBLOCK;
+using url_pattern_index::proto::ACTIVATION_TYPE_GENERICHIDE;
+
+constexpr char kHideDeclaration[] = "{display:none!important}\n";
+
+// The ruleset mapped for this (the renderer main) thread.
+// subresource_filter::MemoryMappedRuleset is not thread-safe, so the renderer
+// keeps its own mapping instead of sharing the browser's. Only called from
+// RenderFrameObserver methods, which all run on the renderer main thread.
+scoped_refptr<const subresource_filter::MemoryMappedRuleset> GetRendererRuleset(
+    const AdblockRuleset::Data& data) {
+  static base::NoDestructor<base::FilePath> mapped_path;
+  static base::NoDestructor<
+      scoped_refptr<const subresource_filter::MemoryMappedRuleset>>
+      ruleset;
+  if (*mapped_path != data.indexed_path() || !*ruleset) {
+    *ruleset = subresource_filter::MemoryMappedRuleset::CreateAndInitialize(
+        base::File(data.indexed_path(),
+                   base::File::FLAG_OPEN | base::File::FLAG_READ));
+    *mapped_path = data.indexed_path();
+  }
+  return *ruleset;
+}
+
+bool IsWebOrigin(const url::Origin& origin) {
+  const std::string& scheme =
+      origin.GetTupleOrPrecursorTupleIfOpaque().scheme();
+  return scheme == url::kHttpScheme || scheme == url::kHttpsScheme;
+}
+
+// Whether `host` is one of `domains` or a subdomain of one.
+bool HostMatchesAny(std::string_view host,
+                    const std::vector<std::string>& domains) {
+  for (const std::string& domain : domains) {
+    if (url::DomainIs(host, domain)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+AdblockRenderFrameObserver::AdblockRenderFrameObserver(
+    content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<AdblockRenderFrameObserver>(
+          render_frame) {}
+
+AdblockRenderFrameObserver::~AdblockRenderFrameObserver() = default;
+
+void AdblockRenderFrameObserver::DidCreateNewDocument() {
+  state_ = DocumentState();
+  has_filter_ = false;
+  pending_css_.clear();
+
+  scoped_refptr<const AdblockRuleset::Data> data =
+      AdblockRuleset::GetInstance().GetData();
+  if (!data) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  // about:blank and srcdoc frames inherit their creator's origin, so ad
+  // scripts writing into such frames are still filtered.
+  document_origin_ = frame->GetSecurityOrigin();
+  if (!IsWebOrigin(document_origin_)) {
+    return;
+  }
+  scoped_refptr<const subresource_filter::MemoryMappedRuleset> ruleset =
+      GetRendererRuleset(*data);
+  if (!ruleset) {
+    return;
+  }
+
+  // Inherit allowlisting from the parent document (single-process: parents
+  // are local frames unless the page is being torn down).
+  url::Origin parent_origin;
+  if (blink::WebFrame* parent = frame->Parent()) {
+    parent_origin = parent->GetSecurityOrigin();
+    content::RenderFrame* parent_render_frame =
+        parent->IsWebLocalFrame()
+            ? content::RenderFrame::FromWebFrame(parent->ToWebLocalFrame())
+            : nullptr;
+    if (auto* parent_observer =
+            parent_render_frame
+                ? AdblockRenderFrameObserver::Get(parent_render_frame)
+                : nullptr) {
+      state_ = parent_observer->state_;
+    }
+  }
+
+  const GURL document_url = frame->GetDocument().Url();
+  if (document_url.SchemeIsHTTPOrHTTPS()) {
+    subresource_filter::IndexedRulesetMatcher matcher(ruleset->data());
+    auto disabled_by = [&](url_pattern_index::proto::ActivationType type) {
+      return matcher.ShouldDisableFilteringForDocument(document_url,
+                                                       parent_origin, type);
+    };
+    state_.filtering_disabled |= disabled_by(ACTIVATION_TYPE_DOCUMENT);
+    if (!state_.filtering_disabled) {
+      state_.generic_blocking_disabled |=
+          disabled_by(ACTIVATION_TYPE_GENERICBLOCK);
+      state_.hiding_disabled |= disabled_by(ACTIVATION_TYPE_ELEMHIDE);
+      state_.generic_hiding_disabled |=
+          disabled_by(ACTIVATION_TYPE_GENERICHIDE);
+    }
+  }
+  if (state_.filtering_disabled) {
+    return;
+  }
+
+  activation_state_ = subresource_filter::mojom::ActivationState();
+  activation_state_.activation_level =
+      subresource_filter::mojom::ActivationLevel::kEnabled;
+  activation_state_.generic_blocking_rules_disabled =
+      state_.generic_blocking_disabled;
+
+  auto filter =
+      std::make_unique<subresource_filter::WebDocumentSubresourceFilterImpl>(
+          document_origin_, activation_state_, ruleset,
+          /*first_disallowed_load_callback=*/base::OnceClosure());
+
+  if (!state_.hiding_disabled &&
+      base::FeatureList::IsEnabled(
+          web::features::kIOSSideloadAdblockElementHiding)) {
+    // Site-specific rules (`example.com##.ad`), minus `#@#` exceptions.
+    std::vector<std::string_view> selectors;
+    filter->GetDomainSelectors(selectors);
+    for (std::string_view selector : selectors) {
+      pending_css_.append(selector);
+      pending_css_.append(kHideDeclaration);
+    }
+    // Generic rules (`##.ad`): main frames only, as the stylesheet is large
+    // and ad iframes are blocked by the navigation throttle anyway.
+    if (!state_.generic_hiding_disabled && frame->IsOutermostMainFrame()) {
+      pending_css_.append(data->generic_css());
+      const std::string& host =
+          document_origin_.GetTupleOrPrecursorTupleIfOpaque().host();
+      for (const auto& excepted : data->generic_exceptions()) {
+        if (!HostMatchesAny(host, excepted.domains)) {
+          pending_css_.append(excepted.selector);
+          pending_css_.append(kHideDeclaration);
+        }
+      }
+    }
+  }
+
+  // Blink takes ownership of the filter.
+  frame->GetDocumentLoader()->SetSubresourceFilter(filter.release());
+  has_filter_ = true;
+}
+
+void AdblockRenderFrameObserver::DidCreateDocumentElement() {
+  if (pending_css_.empty()) {
+    return;
+  }
+  // A user-origin `!important` declaration wins over the page's own
+  // `!important` styles, so ads cannot un-hide themselves with CSS.
+  render_frame()->GetWebFrame()->GetDocument().InsertStyleSheet(
+      blink::WebString::FromUtf8(pending_css_), /*key=*/nullptr,
+      blink::WebCssOrigin::kUser);
+  pending_css_.clear();
+}
+
+void AdblockRenderFrameObserver::WillCreateWorkerFetchContext(
+    blink::WebWorkerFetchContext* worker_fetch_context) {
+  if (!has_filter_) {
+    return;
+  }
+  scoped_refptr<const AdblockRuleset::Data> data =
+      AdblockRuleset::GetInstance().GetData();
+  if (!data) {
+    return;
+  }
+  base::File ruleset_file(data->indexed_path(),
+                          base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!ruleset_file.IsValid()) {
+    return;
+  }
+  // Dedicated workers and worklets map the ruleset on their own thread.
+  worker_fetch_context->SetSubresourceFilterBuilder(
+      std::make_unique<
+          subresource_filter::WebDocumentSubresourceFilterImpl::BuilderImpl>(
+          document_origin_, activation_state_, std::move(ruleset_file),
+          /*first_disallowed_load_callback=*/base::OnceClosure()));
+}
+
+void AdblockRenderFrameObserver::OnDestruct() {
+  delete this;
+}
+
+}  // namespace web::adblock
