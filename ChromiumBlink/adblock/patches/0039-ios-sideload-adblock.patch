@@ -0,0 +1,300 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/adblock/adblock_ruleset.h"
+
+#import <Foundation/Foundation.h>
+
+#import <optional>
+#import <string_view>
+#import <utility>
+
+#import "base/apple/foundation_util.h"
+#import "base/base_paths.h"
+#import "base/feature_list.h"
+#import "base/files/file.h"
+#import "base/files/file_enumerator.h"
+#import "base/files/file_util.h"
+#import "base/functional/bind.h"
+#import "base/hash/hash.h"
+#import "base/logging.h"
+#import "base/path_service.h"
+#import "base/strings/string_number_conversions.h"
+#import "base/strings/string_split.h"
+#import "base/strings/string_util.h"
+#import "base/strings/stringprintf.h"
+#import "base/task/thread_pool.h"
+#import "base/timer/elapsed_timer.h"
+#import "components/subresource_filter/core/common/indexed_ruleset.h"
+#import "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#import "components/url_pattern_index/proto/rules.pb.h"
+#import "components/version_info/version_info.h"
+#import "ios/web/common/features.h"
+
+// Used to find the bundle this code is linked into, which holds the lists.
+@interface CRWSideloadAdblockBundleAnchor : NSObject
+@end
+
+@implementation CRWSideloadAdblockBundleAnchor
+@end
+
+namespace web::adblock {
+
+namespace {
+
+constexpr char kFiltersFile[] = "adblock_filters.txt";
+constexpr char kGenericCssFile[] = "adblock_generic.css";
+constexpr char kGenericExceptionsFile[] = "adblock_generic_exceptions.txt";
+constexpr char kCacheDirName[] = "SideloadAdblock";
+constexpr char kIndexedSuffix[] = ".indexed";
+constexpr char kChecksumSuffix[] = ".checksum";
+// Prefix of the histograms IndexedRulesetMatcher::Verify() records.
+constexpr char kUmaTag[] = "SideloadAdblock";
+
+// The directory holding the bundled lists: the bundle this code is linked
+// into (chrome_framework.framework) or the main app bundle.
+base::FilePath FindListsDirectory() {
+  NSArray<NSBundle*>* bundles = @[
+    [NSBundle bundleForClass:[CRWSideloadAdblockBundleAnchor class]],
+    [NSBundle mainBundle]
+  ];
+  for (NSBundle* bundle in bundles) {
+    if (!bundle.resourcePath) {
+      continue;
+    }
+    base::FilePath dir = base::apple::NSStringToFilePath(bundle.resourcePath);
+    if (base::PathExists(dir.Append(kFiltersFile))) {
+      return dir;
+    }
+  }
+  return base::FilePath();
+}
+
+// Parses adblock_generic_exceptions.txt: "domain,domain<TAB>selector" lines.
+std::vector<AdblockRuleset::Data::ExceptedSelector> ParseGenericExceptions(
+    std::string_view text) {
+  std::vector<AdblockRuleset::Data::ExceptedSelector> result;
+  for (std::string_view line : base::SplitStringPiece(
+           text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    size_t tab = line.find('\t');
+    if (tab == std::string_view::npos || tab == 0 || tab + 1 == line.size()) {
+      continue;
+    }
+    AdblockRuleset::Data::ExceptedSelector entry;
+    entry.domains =
+        base::SplitString(line.substr(0, tab), ",", base::TRIM_WHITESPACE,
+                          base::SPLIT_WANT_NONEMPTY);
+    entry.selector = std::string(line.substr(tab + 1));
+    result.push_back(std::move(entry));
+  }
+  return result;
+}
+
+// Parses `filters` (Adblock Plus syntax, as written by compile_filters.py)
+// and writes the indexed ruleset to `indexed_path`. Returns the checksum, or
+// nullopt on failure.
+std::optional<int> BuildIndexedRuleset(std::string_view filters,
+                                       uint64_t ruleset_id,
+                                       const base::FilePath& indexed_path) {
+  base::ElapsedTimer timer;
+  subresource_filter::RulesetIndexer indexer(ruleset_id);
+  subresource_filter::RuleParser parser;
+  size_t url_rules = 0;
+  size_t style_rules = 0;
+  size_t skipped = 0;
+  for (std::string_view line : base::SplitStringPiece(
+           filters, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    switch (parser.Parse(line)) {
+      case url_pattern_index::proto::RULE_TYPE_URL:
+        if (indexer.AddUrlRule(parser.url_rule().ToProtobuf())) {
+          ++url_rules;
+        } else {
+          ++skipped;
+        }
+        break;
+      case url_pattern_index::proto::RULE_TYPE_STYLE:
+        if (indexer.AddStyleRuleFromProto(parser.style_rule().ToProtobuf())) {
+          ++style_rules;
+        } else {
+          ++skipped;
+        }
+        break;
+      case url_pattern_index::proto::RULE_TYPE_COMMENT:
+        break;
+      default:
+        ++skipped;
+        break;
+    }
+  }
+  indexer.Finish();
+
+  base::FilePath temp_path = indexed_path.AddExtensionASCII("tmp");
+  if (!base::WriteFile(temp_path, indexer.data()) ||
+      !base::ReplaceFile(temp_path, indexed_path, nullptr)) {
+    LOG(WARNING) << "[ios-blink-sideload] adblock: cannot write "
+                 << indexed_path;
+    base::DeleteFile(temp_path);
+    return std::nullopt;
+  }
+  VLOG(1) << "[ios-blink-sideload] adblock: indexed " << url_rules
+          << " URL rules and " << style_rules << " element hiding rules ("
+          << skipped << " skipped) in " << timer.Elapsed();
+  return indexer.GetChecksum();
+}
+
+// Maps `path` and checks it against `checksum`. Returns null on failure.
+std::unique_ptr<base::MemoryMappedFile> MapAndVerify(const base::FilePath& path,
+                                                     int checksum) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  auto mapped = std::make_unique<base::MemoryMappedFile>();
+  if (!file.IsValid() || !mapped->Initialize(std::move(file)) ||
+      !subresource_filter::IndexedRulesetMatcher::Verify(mapped->bytes(),
+                                                         checksum, kUmaTag)) {
+    return nullptr;
+  }
+  return mapped;
+}
+
+// Removes indexed rulesets left over from other list or Chromium versions.
+void DeleteStaleFiles(const base::FilePath& cache_dir, const std::string& key) {
+  base::FileEnumerator files(cache_dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    if (!base::StartsWith(path.BaseName().value(), key)) {
+      base::DeleteFile(path);
+    }
+  }
+}
+
+}  // namespace
+
+AdblockRuleset::Data::ExceptedSelector::ExceptedSelector() = default;
+AdblockRuleset::Data::ExceptedSelector::ExceptedSelector(
+    const ExceptedSelector&) = default;
+AdblockRuleset::Data::ExceptedSelector::ExceptedSelector(ExceptedSelector&&) =
+    default;
+AdblockRuleset::Data::ExceptedSelector::~ExceptedSelector() = default;
+
+AdblockRuleset::Data::Data() = default;
+AdblockRuleset::Data::~Data() = default;
+
+// static
+AdblockRuleset& AdblockRuleset::GetInstance() {
+  static base::NoDestructor<AdblockRuleset> instance;
+  return *instance;
+}
+
+AdblockRuleset::AdblockRuleset() = default;
+AdblockRuleset::~AdblockRuleset() = default;
+
+void AdblockRuleset::StartLoading() {
+  if (!base::FeatureList::IsEnabled(web::features::kIOSSideloadAdblock)) {
+    return;
+  }
+  {
+    base::AutoLock auto_lock(lock_);
+    if (started_) {
+      return;
+    }
+    started_ = true;
+  }
+  // Pages that load before the ruleset is ready are not filtered, so this
+  // runs at USER_BLOCKING priority. After the first launch it only maps the
+  // cached index.
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce([] {
+        AdblockRuleset::GetInstance().Publish(LoadOnBackgroundThread());
+      }));
+}
+
+scoped_refptr<const AdblockRuleset::Data> AdblockRuleset::GetData() const {
+  if (!base::FeatureList::IsEnabled(web::features::kIOSSideloadAdblock)) {
+    return nullptr;
+  }
+  base::AutoLock auto_lock(lock_);
+  return data_;
+}
+
+void AdblockRuleset::Publish(scoped_refptr<const Data> data) {
+  base::AutoLock auto_lock(lock_);
+  data_ = std::move(data);
+}
+
+// static
+scoped_refptr<const AdblockRuleset::Data>
+AdblockRuleset::LoadOnBackgroundThread() {
+  base::FilePath lists_dir = FindListsDirectory();
+  if (lists_dir.empty()) {
+    LOG(WARNING) << "[ios-blink-sideload] adblock: no filter lists in the app "
+                    "bundle (build with ios_sideload_adblock_lists_dir)";
+    return nullptr;
+  }
+
+  std::string filters;
+  if (!base::ReadFileToString(lists_dir.Append(kFiltersFile), &filters)) {
+    LOG(WARNING) << "[ios-blink-sideload] adblock: cannot read "
+                 << kFiltersFile;
+    return nullptr;
+  }
+
+  auto data = base::MakeRefCounted<Data>();
+  // The generic stylesheet and its exceptions are optional.
+  base::ReadFileToString(lists_dir.Append(kGenericCssFile),
+                         &data->generic_css_);
+  std::string exceptions;
+  if (base::ReadFileToString(lists_dir.Append(kGenericExceptionsFile),
+                             &exceptions)) {
+    data->generic_exceptions_ = ParseGenericExceptions(exceptions);
+  }
+
+  base::FilePath cache_dir;
+  if (!base::PathService::Get(base::DIR_CACHE, &cache_dir)) {
+    return nullptr;
+  }
+  cache_dir = cache_dir.Append(kCacheDirName);
+  if (!base::CreateDirectory(cache_dir)) {
+    LOG(WARNING) << "[ios-blink-sideload] adblock: cannot create " << cache_dir;
+    return nullptr;
+  }
+
+  // The index depends on the list contents, the index format and the parser
+  // (i.e. the Chromium version).
+  const uint32_t list_hash = base::PersistentHash(filters);
+  const std::string key = base::StringPrintf(
+      "%08x-%d-%s", list_hash,
+      subresource_filter::RulesetIndexer::kIndexedFormatVersion,
+      std::string(version_info::GetVersionNumber()).c_str());
+  const base::FilePath indexed_path = cache_dir.Append(key + kIndexedSuffix);
+  const base::FilePath checksum_path = cache_dir.Append(key + kChecksumSuffix);
+  DeleteStaleFiles(cache_dir, key);
+
+  std::string checksum_text;
+  int checksum = 0;
+  if (base::ReadFileToString(checksum_path, &checksum_text) &&
+      base::StringToInt(
+          base::TrimWhitespaceASCII(checksum_text, base::TRIM_ALL),
+          &checksum)) {
+    data->mapped_ = MapAndVerify(indexed_path, checksum);
+  }
+  if (!data->mapped_) {
+    std::optional<int> built =
+        BuildIndexedRuleset(filters, list_hash, indexed_path);
+    if (built && base::WriteFile(checksum_path, base::NumberToString(*built))) {
+      data->mapped_ = MapAndVerify(indexed_path, *built);
+    }
+    if (!data->mapped_) {
+      LOG(WARNING) << "[ios-blink-sideload] adblock: indexing failed";
+      base::DeleteFile(indexed_path);
+      base::DeleteFile(checksum_path);
+      return nullptr;
+    }
+  }
+  data->indexed_path_ = indexed_path;
+  return data;
+}
+
+}  // namespace web::adblock
